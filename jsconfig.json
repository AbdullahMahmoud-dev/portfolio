{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      /* This is the key part: it tells VS Code that any path starting with "@/*" 
         (if you were using absolute imports) or any relative path 
         should be resolved relative to the base URL (the project root ".") */
      "*": [
        "*"
      ]
    },
    // Set module resolution specific to React/Vite projects
    "moduleResolution": "node", 
    "target": "ES6",
    "jsx": "react"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}